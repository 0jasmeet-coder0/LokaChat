# Copy to .env for local development. On Koyeb, add each as an environment variable.
# NEVER commit real values, and NEVER put these in the frontend.

# --- Supabase: Project Settings -> API ---
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# "service_role" key (secret!)
SUPABASE_SERVICE_KEY=
# JWT secret: Project Settings -> API -> JWT Settings -> (Legacy) JWT Secret
SUPABASE_JWT_SECRET=

# --- Behaviour ---
# true  = the API returns the OTP in its response (for testing without email/SMS).
# false = REQUIRED in production once SMTP or Twilio below is configured.
OTP_DEV_MODE=true
SESSION_TTL_HOURS=168
# Comma-separated origins, or * to allow any (e.g. https://your-app.vercel.app)
ALLOWED_ORIGINS=*

# --- Email OTP delivery (e.g. Gmail: enable 2-step verification, create an App Password) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- SMS OTP delivery (optional, Twilio) ---
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=

# --- Optional: dedicated key for encrypting stored TOTP secrets ---
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOTP_ENC_KEY=
